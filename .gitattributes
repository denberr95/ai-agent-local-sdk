# Default: testo con fine riga LF (le regole successive hanno la precedenza)
* text=auto eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Common text files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.html text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.properties text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.war binary
*.zip binary
*.gz  binary
