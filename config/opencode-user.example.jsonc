{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode V2 rileva automaticamente i modelli Ollama locali.
  // Creare prima l'alias con: ollama create team-flint -f ollama/Modelfile
  "model": "ollama/team-flint:latest",

  // Nessun controllo automatico degli aggiornamenti verso la rete; aggiornare OpenCode manualmente.
  "update": "disable"
}
